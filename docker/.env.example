# ==============================================================================
# SonarQube & Infrastructure Environment Variables
# Copy this file to .env and adjust variables with your secret values
# ==============================================================================

# SonarQube Server Version (Matches Community Branch Plugin release)
# Check: https://hub.docker.com/r/mc1arke/sonarqube-with-community-branch-plugin
SONARQUBE_VERSION=10.6.0.92116-community

# Public Domain / Subdomain for SonarQube (Used by Caddy for auto Let's Encrypt HTTPS)
# Example: sonar.your-startup.com
SONAR_DOMAIN=sonar.your-startup.com
CADDY_LETSENCRYPT_EMAIL=devops@your-startup.com

# PostgreSQL Credentials
POSTGRES_USER=sonar
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!
POSTGRES_DB=sonar

# SonarQube JVM Memory Allocation (Tuned for 4GB-8GB VPS)
# Reserves 1GB for Elasticsearch, 1GB for SonarQube Web/CE, leaves rest for OS/DB
SONAR_SEARCH_JAVAADDITIONALOPTS=-Dnode.store.allow_mmap=true -Xms1024m -Xmx1024m
SONAR_WEB_JAVAADDITIONALOPTS=-Xms512m -Xmx1024m
SONAR_CE_JAVAADDITIONALOPTS=-Xms512m -Xmx1024m
